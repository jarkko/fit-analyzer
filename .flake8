# Flake8 Configuration
# Python linting for code quality

[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    .tox,
    .pytest_cache

# Error codes to ignore
ignore =
    # E203: whitespace before ':' (conflicts with black)
    E203,
    # W503: line break before binary operator (conflicts with black)
    W503,
    # E501: line too long (handled by max-line-length)
    # E402: module level import not at top of file (sometimes needed)
    E402

# Error codes to specifically check
select = E,W,F,C

# Complexity settings - enforce simpler functions
# After v0.4.2 refactoring, all functions meet these standards
# McCabe complexity: max-complexity = 10 (enforced)
# This aligns with pylint max-branches=12 and our quality standards
max-complexity = 10

# Function length limits (flake8-functions plugin - CFQ codes)
# After v0.4.2 refactoring: longest function is 63 lines
# Set limit to 70 lines to allow some buffer but prevent regressions
# Align with pylint settings for consistency
max-function-length = 70
max-parameters-amount = 7
max-returns-amount = 8

# Per-file ignores
per-file-ignores =
    # Tests can have longer lines and unused imports
    test_*.py:E501,F401,F811
    # Init files can have unused imports
    __init__.py:F401

# Documentation
doctests = True
